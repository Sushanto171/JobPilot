{
  "name": "Backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "pnpm exec tsx --test tests/backend.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "contract:emit": "prisma contract emit",
    "db:update": "prisma db update --db \"$DATABASE_URL\" --confirm jobpilot",
    "db:sync": "pnpm run contract:emit && pnpm run db:update",
    "postinstall": "prisma skills sync || exit 0",
    "migration:status": "prisma migration status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.3",
    "@types/node": "^26.4.0",
    "prisma": "8.0.0-rc.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}

# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:12345@database:5432/jobpilot?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
AUTH_API_URL="http://localhost:3000/api/v1/auth"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
